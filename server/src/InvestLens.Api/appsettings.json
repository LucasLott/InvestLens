{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "InvestLens": "Information"
    }
  },
  "Swagger": {
    "Title": "InvestLens API",
    "Version": "v1",
    "Description": "InvestLens API Documentation",
    "EnableSwaggerProd": false
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "https://localhost:5173"]
  },
  "Authentication":{
    "Jwt": {
      "Issuer": "InvestLens",
      "Audience": "InvestLens",
      "ExpirationInMinutes": 60
    }
  },
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "file": {
        "type": "File",
        "fileName": "${basedir}/Log/InvestLens-${date:format=yyyyMMdd}.log",
        "maxArchiveDays": 30,
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}|${exception:format=Type,StackTrace}"
      },
      "console": {
        "type": "Console",
        "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}|${exception:format=Type,StackTrace}"
      }
    },
    "rules": [
      { "logger": "InvestLens.*", "minLevel": "Info", "writeTo": "file,console", "final": true },
      { "logger": "Program", "minLevel": "Info", "writeTo": "file,console", "final": true }
    ]
  }
}
